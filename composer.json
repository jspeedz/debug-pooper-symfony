{
  "name": "jspeedz/debug-pooper-symfony",
  "description": "Some more debugging methods to be used in a symfony framework (or standalone)",
  "keywords": [
    "dump",
    "debug"
  ],
  "type": "library",
  "minimum-stability": "dev",
  "license": "MIT",
  "authors": [
    {
      "name": "jspeedz",
      "role": "Developer"
    }
  ],
  "autoload": {
    "psr-4": {
      "Jspeedz\\DebugPooper\\": "src/"
    },
    "files": [
      "src/Component/VarDumper/Resources/functions/debugtimer.php",
      "src/Component/VarDumper/Resources/functions/dump.php",
      "src/Component/VarDumper/Resources/functions/dumpquery.php",
      "src/Component/VarDumper/Resources/functions/dumprequest.php",
      "src/Component/VarDumper/Resources/functions/dumpsimplexmlelement.php",
      "src/Component/VarDumper/Resources/functions/dumpsimplexmlelementtree.php"
    ],
    "exclude-from-classmap": [
      "/Tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Jspeedz\\DebugPooper\\Tests\\": "src/Tests"
    }
  },
  "require-dev": {
    "php": ">=8.1",
    "ext-PDO": ">=8.1",
    "doctrine/dbal": "^4",
    "symfony/var-dumper": "^4.1",
    "phpunit/phpunit": "^12.5",
    "php-coveralls/php-coveralls": "2.1.x-dev"
  },
  "require": {
    "ext-simplexml": "*",
    "ext-dom": "*"
  }
}
